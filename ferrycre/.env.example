# --- client (VITE_*) ---------------------------------------------------------
# Google Photorealistic 3D Tiles for the /explore street walk. Optional —
# without it the walk stays on OSM building extrusions and nothing breaks.
# Google Cloud Console → Map Tiles API → key restricted to the domain.
VITE_GOOGLE_3D_TILES_KEY=

# Live listing feed seam (leave false — hand-authored records are the source).
VITE_USE_LIVE_LISTINGS=false

# GA4 measurement ID (G-XXXXXXX). Loads deferred, after paint + idle; the
# site ships zero analytics until this is set.
VITE_GA4_ID=

# --- server (Netlify function env — never VITE_) -----------------------------
# BoldTrail Lead Dropbox address (her instance: antoinetteferry.heymannwilliams.com).
# Until set, leads fall back to direct email below.
BOLDTRAIL_DROPBOX_EMAIL=
LEAD_FALLBACK_EMAIL=ferry@heymannwilliamsrealty.com

# Mail transport: Gmail app password (proven against the dropbox parser)…
GMAIL_USER=
GMAIL_APP_PASSWORD=
# …or any SMTP server.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
